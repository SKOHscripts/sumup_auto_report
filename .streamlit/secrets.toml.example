# ┌─────────────────────────────────────────────────────────────────────────┐
# │  secrets.toml — Copiez ce fichier en secrets.toml et remplissez-le.    │
# │  Ce fichier est un exemple versionné ; secrets.toml est git-ignoré.    │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Application ───────────────────────────────────────────────────────────────
APP_PASSWORD = "votre_mot_de_passe_dashboard"

# ── SumUp API ─────────────────────────────────────────────────────────────────
# Clé API SumUp (Personal API key ou OAuth token)
SUMUP_TOKEN = "sup_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Envoi d'email (SMTP) ──────────────────────────────────────────────────────
# Compte expéditeur (ex : compte Gmail avec mot de passe applicatif)
EMAIL_ADDRESS  = "votre.email@gmail.com"
EMAIL_PASSWORD = "xxxx xxxx xxxx xxxx"   # mot de passe applicatif Google

# Paramètres SMTP (valeurs Gmail par défaut)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"

# ── Listes de diffusion ───────────────────────────────────────────────────────
# Adresses séparées par des virgules.
# Ces valeurs sont proposées par défaut dans l'interface ; l'utilisateur peut
# les modifier avant de lancer chaque script.

# Utilisée par : Statistiques SumUp
EMAIL_TO = "destinataire@example.com"

# Utilisée par : Rapport Stocks, Tableau de bord Paheko
EMAIL_TO_SUMUP_ALL_CA = "ca1@example.com, ca2@example.com"

# Utilisée par : Rapport Adhésions
EMAIL_TO_SUMUP_FINANCE = "finance@example.com"

# Utilisée par : (scripts futurs)
EMAIL_TO_SUMUP_VIE = "vie@example.com"

# ── Paheko API ────────────────────────────────────────────────────────────────
PAHEKO_BASE_URL      = "https://paheko.example.com"
PAHEKO_API_USER      = "utilisateur_api"
PAHEKO_API_PASSWORD  = "mot_de_passe_api"

# ── Paheko — configuration des champs (optionnel) ─────────────────────────────
# Décommentez et adaptez selon votre instance Paheko.
# PAHEKO_SQL_LIMIT            = "10000"
# PAHEKO_SAVE_RAW_JSON        = "1"
# PAHEKO_USERS_TABLE          = "users"
# PAHEKO_CATEGORIES_TABLE     = "users_categories"
# PAHEKO_USER_CATEGORY_FIELD  = "id_category"
# PAHEKO_CATEGORY_ID_FIELD    = "id"
# PAHEKO_CATEGORY_LABEL_FIELD = "name"
# PAHEKO_FIELD_BIRTHDATE      = "date_naissance"
# PAHEKO_FIELD_BIRTHYEAR      = ""
# PAHEKO_FIELD_NEWSLETTER     = "newsletter"
# PAHEKO_FIELD_SIGNUP_DATE    = "date_inscription"
# PAHEKO_FIELD_POSTAL_CODE    = "code_postal"
# PAHEKO_FIELD_CITY           = "ville"
